# Privy — get these from https://dashboard.privy.io (App settings)
# Both are required by PrivyProvider as of @privy-io/react-auth v3.x.
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
NEXT_PUBLIC_PRIVY_CLIENT_ID=your-app-client-id

# Base — no key needed for Base Account sign-in / pay() on testnet.
# Mainnet chainId is 0x2105 (8453); the scaffold defaults to testnet.
